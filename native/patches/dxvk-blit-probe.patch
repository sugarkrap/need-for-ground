     args.samplerGamma = m_samplerGamma->getDescriptor().samplerIndex;
     args.samplerCursor = cursorSampler;
 
+    if (m_probeEnabled > 0 && m_probeFrame < 6u) {
+      Logger::warn(str::format("NFSU2-BLIT-PROBE: pipeline=",
+        reinterpret_cast<uint64_t>(pipeline),
+        " viewport=", viewport.width, "x", viewport.height,
+        " depth=[", viewport.minDepth, ",", viewport.maxDepth, "]",
+        " scissor=", scissor.extent.width, "x", scissor.extent.height,
+        " descriptors=", descriptors.size(),
+        " srcOffset=", args.srcOffset.x, ",", args.srcOffset.y,
+        " srcExtent=", args.srcExtent.width, "x", args.srcExtent.height));
+    }
+
     ctx->cmdBindPipeline(DxvkCmdBuffer::ExecBuffer,
       VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
 
