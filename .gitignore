# Never commit game binaries/artifacts - this repo is tools only.
*.exe
*.dll
*.bin
*.pfd
*.iso
*.rar
*.zip
*.7z
*.bun
*.abk
*.mxb
*.csi
*.viv

# Ghidra project data embeds analyzed binary content
*.gpr
*.rep/
ghidra-project/
ghidra-projects/

# analysis/working output - bulk-decompiled pseudocode is a direct
# derivative of the copyrighted game binary, same category as the binary
# itself. Never commit it.
out/
output/
dumps/
decompiled/
# ...and any staging copy of it. A re-decompile writes to a fresh directory so the
# existing tree stays usable until it is complete, and `decompiled/` alone would
# not have covered that - the derivative would have been committable.
decompiled*/
scratch/
scratchpad/
*.log

# native port: build trees and third-party checkouts (DXVK is fetched by
# native/tools/build_dxvk_native.sh, never vendored here)
native/build*/
native/third_party/

# Ported game functions, generated from decompiled/ by
# native/tools/import_decompiled.py. Same category as decompiled/ itself: a
# derivative of the copyrighted binary. The manifest and the tooling are
# committed; the code they produce is not.
native/game/generated/
b32/
b64/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
